<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Tomidix.Dirigera</PackageId>
    <PackageProjectUrl>https://github.com/dominicusmento/CSharpTradFriLibrary/tree/master/Dirigera</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/dominicusmento/CSharpTradFriLibrary.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ikea;tradfri;home;zigbee;csharp;net10;dirigera</PackageTags>
    <Description>This is an open source helper library which you can use to communicate with your ZigBee-based Ikea Dirigera gateway</Description>
    <Authors>mjwsteenbergen;tomidix</Authors>
    <Version>2.0.0</Version>
    <RootNamespace>Tomidix.NetStandard.Dirigera</RootNamespace>
    <AssemblyName>Tomidix.Dirigera</AssemblyName>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ApiLibs\ApiLibs\ApiLibs.csproj" />
    <!-- Pinned above the versions ApiLibs pulls in transitively, to clear known vulnerabilities and a Microsoft.Bcl.AsyncInterfaces version conflict -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="RestSharp" Version="112.0.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>